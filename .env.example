# Copy this file to .env and fill it in (kept out of git).
# Loaded automatically by app.py, check_setup.py and setup_gpu.sh.

# HuggingFace token — authenticates model downloads (silences the
# "unauthenticated requests" warning, higher rate limits, faster downloads).
# Create one at https://huggingface.co/settings/tokens — "Read" access is enough.
HF_TOKEN=

# Optional overrides:
# PORT=8000            # app port (default 8000)
# MANGA_UPSCALE=1      # set 0 to disable Real-ESRGAN upscaling of low-res raws
# UPSCALE_MODEL=       # custom path to Real-ESRGAN weights
# TEXT_SEG_MODEL=      # custom path to comic-text-detector weights
