__pycache__/
*.pyc
uploads/
output/
*.egg-info/
.env

# Learned series style profiles (user data)
profiles/

# Downloaded model weights (auto-fetched on first use — never committed)
models/

# User-added lettering fonts: licensed files (Blambot, Comicraft) must never
# land in a public repo. The fonts that SHIP with the app are already tracked
# and stay tracked — ignore rules never untrack a file — so this only hides
# new additions.
fonts/*.ttf
fonts/*.TTF
fonts/*.otf

# Local agent/tooling worktrees — never part of the project
.claude/
# Browser-test scratch (generated inputs and screenshots)
tests/ui/_inputs/
tests/ui/_shots/
